import React, { useEffect, useRef, useMemo, useState } from 'react';
import { View, Text, StyleSheet, StatusBar, ScrollView, TouchableOpacity, Dimensions, Animated, Platform, TextInput } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { Ionicons } from '@expo/vector-icons';
import { LinearGradient } from 'expo-linear-gradient';
import { spacing, borderRadius, shadows } from '../constants/colors';
import { useUser } from '../context/UserContext';
import { useTheme } from '../context/ThemeContext';
import ExplanationModal from '../components/ExplanationModal';

const { width } = Dimensions.get('window');

const QUOTES = [
    "Discipline builds what motivation cannot.",
    "Train even when no one is watching.",
    "Strength is earned in silence.",
    "Consistency turns effort into results.",
    "Show up. Execute. Repeat.",
];

const DashboardScreen = ({ navigation }) => {
    const { userData, addWater, removeWater, checkAndResetDaily, updateProfile } = useUser();
    const { theme } = useTheme();

    const fadeAnim = useRef(new Animated.Value(0)).current;
    const slideAnim = useRef(new Animated.Value(20)).current;
    const weightCardAnim = useRef(new Animated.Value(1)).current;
    const [showWhyModal, setShowWhyModal] = useState(false);
    const [showWeightLogger, setShowWeightLogger] = useState(false);
    const [weightInput, setWeightInput] = useState('');

    useEffect(() => {
        checkAndResetDaily();
        
        // 3 AM Reset Logic for Weight Logger
        const checkWeightLogger = () => {
            const today = new Date();
            today.setHours(today.getHours() - 3); // Shift by -3 hours so 2:59 AM counts as yesterday
            const dateString = today.toISOString().split('T')[0];
            
            if (userData.lastWeightLogDate !== dateString) {
                setShowWeightLogger(true);
            }
        };
        
        checkWeightLogger();
        Animated.parallel([
            Animated.timing(fadeAnim, { toValue: 1, duration: 800, useNativeDriver: true }),
            Animated.spring(slideAnim, { toValue: 0, tension: 40, friction: 8, useNativeDriver: true }),
        ]).start();
    }, []);

    const formatName = (name) => {
        if (!name) return 'User';
        return name.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()).join(' ');
    };

    const userName = formatName(userData.name);
    const getDailyQuote = () => QUOTES[new Date().getDay() % QUOTES.length];
    const dailyQuote = getDailyQuote();
    const dateString = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });

    // Nutrition Data
    const caloriesConsumed = userData.dailyCalories || 0;
    const caloriesGoal = userData.calorieGoal || 2000;
    const isOverLimit = caloriesConsumed > caloriesGoal;
    const caloriesProgress = Math.min(1, caloriesConsumed / caloriesGoal);
    const remaining = Math.max(0, caloriesGoal - caloriesConsumed);

    const macros = [
        { name: 'PROTEIN', consumed: Math.round(userData.proteinConsumed || 0), goal: Math.round(userData.proteinGoal || 0), color: theme.protein },
        { name: 'CARBS', consumed: Math.round(userData.carbsConsumed || 0), goal: Math.round(userData.carbsGoal || 0), color: theme.carbs },
        { name: 'FATS', consumed: Math.round(userData.fatsConsumed || 0), goal: Math.round(userData.fatsGoal || 0), color: theme.fats },
    ];

    // Hydration Data
    const waterGlasses = userData.waterIntake || 0;
    const waterGoalMl = userData.waterGoal || 2000;
    const maxGlasses = Math.ceil(waterGoalMl / 250);
    const waterPercent = Math.min(100, (waterGlasses / maxGlasses) * 100);

    const handleLogWeight = () => {
        if (!weightInput || isNaN(weightInput)) return;
        
        const today = new Date();
        today.setHours(today.getHours() - 3);
        const dateString = today.toISOString().split('T')[0];
        
        updateProfile({
            currentWeight: parseFloat(weightInput).toString(),
            lastWeightLogDate: dateString
        });
        
        Animated.timing(weightCardAnim, {
            toValue: 0,
            duration: 300,
            useNativeDriver: true
        }).start(() => setShowWeightLogger(false));
    };

    const handleDismissWeightLogger = () => {
        const today = new Date();
        today.setHours(today.getHours() - 3);
        const dateString = today.toISOString().split('T')[0];
        
        updateProfile({
            lastWeightLogDate: dateString
        });
        
        Animated.timing(weightCardAnim, {
            toValue: 0,
            duration: 300,
            useNativeDriver: true
        }).start(() => setShowWeightLogger(false));
    };

    const styles = useMemo(() => createStyles(theme), [theme]);

    return (
        <SafeAreaView style={styles.container} edges={['top']}>
            <StatusBar barStyle="light-content" backgroundColor="#000000" />
            
            {/* Ultra-minimalist dark background */}
            <LinearGradient
                colors={['#050A08', '#000000', '#000000']}
                style={StyleSheet.absoluteFill}
                start={{ x: 0, y: 0 }}
                end={{ x: 0, y: 1 }}
            />

            <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={styles.scroll}>
                
                {/* Premium Header */}
                <Animated.View style={[styles.header, { opacity: fadeAnim, transform: [{ translateY: slideAnim }] }]}>
                    <View style={styles.headerLeft}>
                        <Text style={styles.dateText}>{dateString.toUpperCase()}</Text>
                        <Text style={styles.userName}>Hello, {userName}</Text>
                        <Text style={styles.dailyQuote}>{dailyQuote}</Text>
                    </View>
                    <TouchableOpacity style={styles.profileAvatar} onPress={() => navigation.navigate('Profile')}>
                        <Ionicons name="person" size={20} color={theme.textPrimary} />
                    </TouchableOpacity>
                </Animated.View>

                {/* Morning Weight Logger */}
                {showWeightLogger && (
                    <Animated.View style={[styles.weightCard, { opacity: weightCardAnim, transform: [{ scale: weightCardAnim }] }]}>
                        <View style={styles.weightCardHeader}>
                            <View style={{flexDirection: 'row', alignItems: 'center', gap: 8}}>
                                <Ionicons name="scale-outline" size={20} color={theme.primary} />
                                <Text style={styles.weightCardTitle}>LOG MORNING WEIGHT</Text>
                            </View>
                            <TouchableOpacity onPress={handleDismissWeightLogger} style={{padding: 4}}>
                                <Ionicons name="close" size={20} color={theme.textMuted} />
                            </TouchableOpacity>
                        </View>
                        <View style={styles.weightInputRow}>
                            <TextInput 
                                style={styles.weightInput}
                                placeholder="0.0"
                                placeholderTextColor="#666"
                                keyboardType="numeric"
                                value={weightInput}
                                onChangeText={setWeightInput}
                            />
                            <Text style={styles.weightUnit}>kg</Text>
                            <TouchableOpacity style={[styles.weightSaveBtn, { backgroundColor: theme.primary }]} onPress={handleLogWeight}>
                                <Text style={styles.weightSaveText}>Save</Text>
                            </TouchableOpacity>
                        </View>
                    </Animated.View>
                )}

                {/* Daily Summary Glass Card */}
                <Animated.View style={[styles.glassCard, { opacity: fadeAnim, transform: [{ translateY: slideAnim }] }]}>
                    <View style={styles.cardHeader}>
                        <Text style={styles.cardTitle}>NUTRITION SUMMARY</Text>
                        <TouchableOpacity onPress={() => setShowWhyModal(true)}>
                            <Ionicons name="information-circle-outline" size={18} color={theme.textMuted} />
                        </TouchableOpacity>
                    </View>

                    <View style={styles.nutritionContent}>
                        {/* Fuel Gauge for Calories */}
                        <View style={styles.fuelGaugeContainer}>
                            <View style={styles.fuelHeader}>
                                <Text style={styles.fuelTitle}>CALORIES</Text>
                                <Text style={[styles.fuelValue, isOverLimit && { color: theme.error }]}>{caloriesConsumed} <Text style={styles.fuelGoal}>/ {caloriesGoal} kcal</Text></Text>
                            </View>
                            <View style={styles.fuelBarBg}>
                                <View style={[styles.fuelBarFill, { backgroundColor: isOverLimit ? theme.error : theme.primary, width: `${Math.min(100, caloriesProgress * 100)}%` }]} />
                            </View>
                        </View>

                        {/* 3-Column Macro Grid */}
                        <View style={styles.macroGrid}>
                            {macros.map((m, i) => (
                                <View key={i} style={styles.macroColumn}>
                                    <Text style={styles.macroColName}>{m.name}</Text>
                                    <Text style={styles.macroColValue}>{m.consumed}g</Text>
                                    <Text style={styles.macroColGoal}>/ {m.goal}g</Text>
                                    <View style={styles.macroColIndicatorBg}>
                                        <View style={[styles.macroColIndicatorFill, { backgroundColor: m.color, width: `${Math.min(100, (m.consumed / (m.goal || 1)) * 100)}%` }]} />
                                    </View>
                                </View>
                            ))}
                        </View>
                    </View>
                </Animated.View>

                {/* Today's Training */}
                <Animated.View style={[styles.glassCard, { opacity: fadeAnim, transform: [{ translateY: slideAnim }] }]}>
                    <View style={styles.cardHeader}>
                        <Text style={styles.cardTitle}>{hasTrainedToday ? "NUTRITION" : "TODAY'S TRAINING"}</Text>
                    </View>
                    
                    {hasTrainedToday ? (
                        <TouchableOpacity
                            style={[styles.trainingCard, { backgroundColor: theme.primary + '15', borderColor: theme.primary + '40' }]}
                            onPress={() => navigation.navigate('CreateMeal')}
                        >
                            <View style={styles.trainingInfo}>
                                <Text style={[styles.trainingBadge, { color: theme.primary }]}>LOG FOOD</Text>
                                <Text style={styles.trainingTitle}>Track Nutrition</Text>
                                <Text style={styles.trainingSub}>Add meals to reach your goals</Text>
                            </View>
                            <View style={[styles.playButton, { backgroundColor: theme.primary }]}>
                                <Ionicons name="fast-food" size={20} color="#000" />
                            </View>
                        </TouchableOpacity>
                    ) : userData.activeWorkoutSession ? (
                        <TouchableOpacity
                            style={[styles.trainingCard, { backgroundColor: theme.brandWorkout + '15', borderColor: theme.brandWorkout + '40' }]}
                            onPress={() => navigation.navigate('WorkoutSession', { resumeSession: true, skipTimeModal: true })}
                        >
                            <View style={styles.trainingInfo}>
                                <Text style={styles.trainingBadge}>IN PROGRESS</Text>
                                <Text style={styles.trainingTitle}>{userData.activeWorkoutSession.title}</Text>
                                <Text style={styles.trainingSub}>Resume your session</Text>
                            </View>
                            <View style={[styles.playButton, { backgroundColor: theme.brandWorkout }]}>
                                <Ionicons name="play" size={20} color="#000" />
                            </View>
                        </TouchableOpacity>
                    ) : userData.trainingPlan ? (
                        <TouchableOpacity
                            style={styles.trainingCard}
                            onPress={() => {
                                const today = new Date().getDay();
                                const sessionIdx = (today === 0 ? 6 : today - 1) % userData.trainingPlan.schedule.length;
                                const todaySession = userData.trainingPlan.schedule[sessionIdx];
                                if(todaySession) {
                                    navigation.navigate('WorkoutSession', {
                                        title: todaySession.title,
                                        zones: todaySession.zones,
                                        exerciseLimit: todaySession.exerciseLimit,
                                        preloadedExercises: todaySession.exercises || [],
                                        skipTimeModal: true,
                                    });
                                }
                            }}
                        >
                            <View style={styles.trainingInfo}>
                                <Text style={styles.trainingBadge}>SCHEDULED</Text>
                                <Text style={styles.trainingTitle}>
                                    {userData.trainingPlan.schedule[(new Date().getDay() === 0 ? 6 : new Date().getDay() - 1) % userData.trainingPlan.schedule.length]?.title || 'Rest Day'}
                                </Text>
                                <Text style={styles.trainingSub}>{userData.trainingPlan.splitType?.toUpperCase() || 'PLAN'}</Text>
                            </View>
                            <View style={styles.playButton}>
                                <Ionicons name="play" size={20} color="#000" />
                            </View>
                        </TouchableOpacity>
                    ) : (
                        <TouchableOpacity style={styles.trainingCard} onPress={() => navigation.navigate('WorkoutSelection')}>
                            <View style={styles.trainingInfo}>
                                <Text style={styles.trainingTitle}>No Plan Active</Text>
                                <Text style={styles.trainingSub}>Tap to start a custom workout</Text>
                            </View>
                            <Ionicons name="arrow-forward" size={24} color={theme.textMuted} />
                        </TouchableOpacity>
                    )}
                </Animated.View>

                {/* Full-Width Liquid Hydration Bar */}
                <Animated.View style={[styles.liquidHydrationCard, { opacity: fadeAnim, transform: [{ translateY: slideAnim }] }]}>
                    <View style={styles.liquidHeader}>
                        <View style={{flexDirection: 'row', alignItems: 'center', gap: 6}}>
                            <Ionicons name="water-outline" size={16} color={theme.water} />
                            <Text style={styles.cardTitle}>HYDRATION</Text>
                        </View>
                        <Text style={styles.liquidValue}>{waterGlasses * 250} <Text style={styles.liquidGoal}>/ {waterGoalMl} ml</Text></Text>
                    </View>
                    <View style={styles.liquidBarContainer}>
                        <TouchableOpacity style={styles.liquidBtn} onPress={() => removeWater(1)}>
                            <Ionicons name="remove" size={20} color={theme.textPrimary}/>
                        </TouchableOpacity>
                        
                        <View style={styles.liquidTrack}>
                            <View style={[styles.liquidFill, { width: `${waterPercent}%`, backgroundColor: theme.water }]} />
                        </View>

                        <TouchableOpacity style={[styles.liquidBtn, {backgroundColor: theme.water}]} onPress={() => addWater(1)}>
                            <Ionicons name="add" size={20} color="#000"/>
                        </TouchableOpacity>
                    </View>
                </Animated.View>

                <View style={{ height: 120 }} />
            </ScrollView>

            {/* Floating Quick Actions Bar */}
            <View style={styles.floatingBar}>
                <TouchableOpacity style={styles.fabItem} onPress={() => navigation.navigate('AddMeal')}>
                    <Ionicons name="scan-outline" size={22} color={theme.textPrimary} />
                    <Text style={styles.fabText}>Food</Text>
                </TouchableOpacity>
                
                <TouchableOpacity style={styles.fabItem} onPress={() => navigation.navigate('AIChat')}>
                    <View style={styles.fabCenterIcon}>
                        <Ionicons name="sparkles" size={22} color={theme.brandAI || '#40916C'} />
                    </View>
                    <Text style={[styles.fabText, { color: theme.brandAI || '#40916C' }]}>Coach</Text>
                </TouchableOpacity>

                <TouchableOpacity style={styles.fabItem} onPress={() => navigation.navigate('WorkoutSelection')}>
                    <Ionicons name="barbell-outline" size={22} color={theme.textPrimary} />
                    <Text style={styles.fabText}>Train</Text>
                </TouchableOpacity>
            </View>

            <ExplanationModal
                visible={showWhyModal}
                onClose={() => setShowWhyModal(false)}
                title="System Status"
                content={[`Calories: ${caloriesConsumed}/${caloriesGoal}`, `Deficit/Surplus tracking is active.`]}
            />
        </SafeAreaView>
    );
};

const createStyles = (theme) => StyleSheet.create({
    container: { flex: 1, backgroundColor: '#000' },
    scroll: { padding: spacing.lg },
    
    header: { marginBottom: spacing.xl, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginTop: 10 },
    headerLeft: { flex: 1 },
    dateText: { fontSize: 10, fontWeight: '800', color: theme.primary, letterSpacing: 1.5, marginBottom: 4 },
    userName: { fontSize: 28, fontWeight: '700', color: '#FFF', letterSpacing: -0.5, marginBottom: 4 },
    dailyQuote: { fontSize: 13, color: '#888', fontStyle: 'italic' },
    profileAvatar: { width: 44, height: 44, borderRadius: 22, backgroundColor: 'rgba(255,255,255,0.08)', alignItems: 'center', justifyContent: 'center', borderWidth: 1, borderColor: 'rgba(255,255,255,0.1)' },

    glassCard: {
        backgroundColor: 'rgba(255, 255, 255, 0.03)',
        borderRadius: 24,
        padding: spacing.xl,
        marginBottom: spacing.lg,
        borderWidth: 1,
        borderColor: 'rgba(255, 255, 255, 0.08)',
        shadowColor: '#000',
        shadowOffset: { width: 0, height: 10 },
        shadowOpacity: 0.3,
        shadowRadius: 20,
    },
    weightCard: {
        backgroundColor: 'rgba(255, 255, 255, 0.05)',
        borderRadius: 24,
        padding: spacing.lg,
        marginBottom: spacing.lg,
        borderWidth: 1,
        borderColor: 'rgba(64, 145, 108, 0.3)',
    },
    weightCardHeader: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', marginBottom: 16 },
    weightCardTitle: { fontSize: 11, fontWeight: '800', color: '#FFF', letterSpacing: 1.5 },
    weightInputRow: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' },
    weightInput: { flex: 1, height: 50, backgroundColor: 'rgba(0,0,0,0.3)', borderRadius: 12, color: '#FFF', fontSize: 22, fontWeight: '800', textAlign: 'center', marginRight: 12 },
    weightUnit: { fontSize: 16, fontWeight: '600', color: '#888', marginRight: 12 },
    weightSaveBtn: { paddingHorizontal: 24, height: 50, borderRadius: 12, alignItems: 'center', justifyContent: 'center' },
    weightSaveText: { fontSize: 14, fontWeight: '700', color: '#000' },
    cardHeader: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: spacing.lg },
    cardTitle: { fontSize: 11, fontWeight: '800', color: '#888', letterSpacing: 1.5 },

    nutritionContent: { gap: spacing.xl },
    
    fuelGaugeContainer: { gap: 8 },
    fuelHeader: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' },
    fuelTitle: { fontSize: 12, fontWeight: '800', color: '#888', letterSpacing: 1.5 },
    fuelValue: { fontSize: 26, fontWeight: '800', color: '#FFF', letterSpacing: -0.5 },
    fuelGoal: { fontSize: 14, color: '#666', fontWeight: '600', letterSpacing: 0 },
    fuelBarBg: { height: 16, backgroundColor: 'rgba(255,255,255,0.06)', borderRadius: 8, overflow: 'hidden' },
    fuelBarFill: { height: '100%', borderRadius: 8 },

    macroGrid: { flexDirection: 'row', justifyContent: 'space-between', gap: spacing.lg, paddingHorizontal: spacing.sm, marginTop: spacing.md },
    macroColumn: { flex: 1, alignItems: 'center' },
    macroColName: { fontSize: 12, fontWeight: '800', color: '#AAA', letterSpacing: 1, marginBottom: 8, textAlign: 'center' },
    macroColValue: { fontSize: 28, fontWeight: '800', color: '#FFF', letterSpacing: -0.5, textAlign: 'center', marginBottom: 4 },
    macroColGoal: { fontSize: 14, color: '#666', fontWeight: '600', marginBottom: 14, textAlign: 'center' },
    macroColIndicatorBg: { height: 6, width: '90%', backgroundColor: 'rgba(255,255,255,0.08)', borderRadius: 3, overflow: 'hidden' },
    macroColIndicatorFill: { height: '100%', borderRadius: 3 },

    trainingCard: { flexDirection: 'row', alignItems: 'center', backgroundColor: 'rgba(255,255,255,0.05)', borderRadius: 16, padding: spacing.md, borderWidth: 1, borderColor: 'rgba(255,255,255,0.05)' },
    trainingInfo: { flex: 1 },
    trainingBadge: { fontSize: 9, fontWeight: '800', color: theme.brandWorkout, letterSpacing: 1, marginBottom: 4 },
    trainingTitle: { fontSize: 18, fontWeight: '700', color: '#FFF', marginBottom: 2 },
    trainingSub: { fontSize: 12, color: '#888', fontWeight: '500' },
    playButton: { width: 44, height: 44, borderRadius: 22, backgroundColor: '#FFF', alignItems: 'center', justifyContent: 'center' },

    liquidHydrationCard: { backgroundColor: 'rgba(255, 255, 255, 0.03)', borderRadius: 24, padding: spacing.lg, marginBottom: spacing.lg, borderWidth: 1, borderColor: 'rgba(255, 255, 255, 0.08)' },
    liquidHeader: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 },
    liquidValue: { fontSize: 16, fontWeight: '800', color: '#FFF' },
    liquidGoal: { fontSize: 11, fontWeight: '600', color: '#666' },
    liquidBarContainer: { flexDirection: 'row', alignItems: 'center', gap: 12 },
    liquidBtn: { width: 44, height: 44, borderRadius: 22, backgroundColor: 'rgba(255,255,255,0.08)', alignItems: 'center', justifyContent: 'center' },
    liquidTrack: { flex: 1, height: 24, backgroundColor: 'rgba(0,0,0,0.3)', borderRadius: 12, overflow: 'hidden' },
    liquidFill: { height: '100%', borderRadius: 12 },

    floatingBar: {
        position: 'absolute',
        bottom: 30,
        left: 30,
        right: 30,
        height: 70,
        backgroundColor: 'rgba(15, 15, 15, 0.95)',
        borderRadius: 35,
        flexDirection: 'row',
        alignItems: 'center',
        justifyContent: 'space-evenly',
        borderWidth: 1,
        borderColor: 'rgba(255,255,255,0.1)',
        shadowColor: '#000',
        shadowOffset: { width: 0, height: 10 },
        shadowOpacity: 0.5,
        shadowRadius: 20,
        elevation: 10,
    },
    fabItem: { alignItems: 'center', justifyContent: 'center', paddingHorizontal: 20 },
    fabText: { fontSize: 10, color: '#AAA', fontWeight: '700', marginTop: 4, letterSpacing: 0.5 },
    fabCenterIcon: { padding: 2, borderRadius: 12, backgroundColor: 'rgba(64, 145, 108, 0.15)' },
});

export default DashboardScreen;
